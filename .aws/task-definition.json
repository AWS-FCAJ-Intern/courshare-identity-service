{
    "family": "default-identity-service",
    "containerDefinitions": [
        {
            "name": "Main",
            "image": "307506883737.dkr.ecr.ap-southeast-1.amazonaws.com/courshare-identity-service:latest",
            "cpu": 256,
            "memory": 512,
            "portMappings": [
                {
                    "containerPort": 8081,
                    "hostPort": 8081,
                    "protocol": "tcp",
                    "name": "main-8080-tcp"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "MANAGEMENT_HEALTH_REDIS_ENABLED",
                    "value": "false"
                },
                {
                    "name": "DATABASE_URL",
                    "value": "postgresql://identity_user:IdentityPassSecure123!@courshare-shared-db.c9ekmoesqqkt.ap-southeast-1.rds.amazonaws.com:5432/identity_db?sslmode=require"
                },
                {
                    "name": "JWT_SECRET",
                    "value": "CourShareSuperSecretKey2026!ForJwtAuthorizationToken"
                },
                {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "value": "IdentityPassSecure123!"
                },
                {
                    "name": "SPRING_DATASOURCE_URL",
                    "value": "jdbc:postgresql://courshare-shared-db.c9ekmoesqqkt.ap-southeast-1.rds.amazonaws.com:5432/identity_db?sslmode=require"
                },
                {
                    "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
                    "value": "update"
                },
                {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "value": "identity_user"
                },
                {
                "name": "COURSHARE_JWT_KEY_ID",
                "value": "courshare-key-1"
                },{
                    "name": "SPRING_DATA_REDIS_HOST",
                    "value": "courshare-redis-identity-j24w1j.serverless.apse1.cache.amazonaws.com:6379"
                },{
                    "name":"SPRING_DATA_REDIS_PORT",
                    "value":"6379"
                },{
                    "name":"SPRING_DATA_REDIS_SSL_ENABLED",
                    "value":"true"
                },{
                    "name":"SPRING_MAIL_HOST",
                    "value":"arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/otp-mail-I85Xj1:SPRING_MAIL_HOST::"
                },{
                    "name":"SPRING_MAIL_PORT",
                    "value":"arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/otp-mail-I85Xj1:SPRING_MAIL_PORT::"
                },{
                    "name":"SPRING_MAIL_USERNAME",
                    "value":"arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/otp-mail-I85Xj1:SPRING_MAIL_USERNAME::"
                },{
                    "name":"SPRING_MAIL_PASSWORD",
                    "value":"arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/otp-mail-I85Xj1:SPRING_MAIL_PASSWORD::"
                },{
                    "name":"SPRING_MAIL_FROM",
                    "value":"arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/otp-mail-I85Xj1:SPRING_MAIL_FROM::"
                }
            ],
            "secrets": [
                {
                "name": "COURSHARE_JWT_PRIVATE_KEY_PEM",
                "valueFrom": "arn:aws:secretsmanager:ap-southeast-1:307506883737:secret:courshare/jwt/private_key-fSbFa2"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/aws/ecs/default/identity-service-9931",
                    "awslogs-region": "ap-southeast-1",
                    "awslogs-stream-prefix": "ecs"
                }
            },
            "systemControls": []
        }
    ],
    "executionRoleArn": "arn:aws:iam::307506883737:role/service-role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
}
